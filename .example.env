#* MySQL
MYSQL_ROOT_USERNAME=root #! default can not change
MYSQL_ROOT_PASSWORD=<YOUR_MYSQL_ROOT_PASSWORD>
MYSQL_DATABASE_HOST=<YOUR_MYSQL_DATABASE_HOST> #! 绑定IP，例如 0.0.0.0 (所有接口) 或 127.0.0.1 (仅本地) 或 192.168.1.64 (指定IP)
MYSQL_DATABASE_PORT=<YOUR_MYSQL_DATABASE_PORT>
MYSQL_UI_HOST=<YOUR_MYSQL_UI_HOST> #! 绑定IP，例如 0.0.0.0 (所有接口) 或 127.0.0.1 (仅本地) 或 192.168.1.64 (指定IP)
MYSQL_UI_PORT=<YOUR_MYSQL_UI_PORT>

#* MONGODB
MONGO_ROOT_USERNAME=<YOUR_MONGO_ROOT_USERNAME>
MONGO_ROOT_PASSWORD=<YOUR_MONGO_ROOT_PASSWORD>
MONGO_DATABASE_HOST=<YOUR_MONGO_DATABASE_HOST> #! 绑定IP，例如 0.0.0.0 (所有接口) 或 127.0.0.1 (仅本地) 或 192.168.1.64 (指定IP)
MONGO_DATABASE_PORT=<YOUR_MONGO_DATABASE_PORT>
MONGO_UI_USERNAME=<YOUR_MONGO_UI_USERNAME>
MONGO_UI_PASSWORD=<YOUR_MONGO_UI_PASSWORD>
MONGO_UI_HOST=<YOUR_MONGO_UI_HOST> #! 绑定IP，例如 0.0.0.0 (所有接口) 或 127.0.0.1 (仅本地) 或 192.168.1.64 (指定IP)
MONGO_UI_PORT=<YOUR_MONGO_UI_PORT>

#* PostgreSQL 
POSTGRESQL_ROOT_USERNAME=<YOUR_POSTGRESQL_ROOT_USERNAME>
POSTGRESQL_ROOT_PASSWORD=<YOUR_POSTGRESQL_ROOT_PASSWORD>
POSTGRESQL_DATABASE_HOST=<YOUR_POSTGRESQL_DATABASE_HOST> #! 绑定IP，例如 0.0.0.0 (所有接口) 或 127.0.0.1 (仅本地) 或 192.168.1.64 (指定IP)
POSTGRESQL_DATABASE_PORT=<YOUR_POSTGRESQL_DATABASE_PORT>
POSTGRESQL_UI_HOST=<YOUR_POSTGRESQL_UI_HOST> #! 绑定IP，例如 0.0.0.0 (所有接口) 或 127.0.0.1 (仅本地) 或 192.168.1.64 (指定IP)
POSTGRESQL_UI_PORT=<YOUR_POSTGRESQL_UI_PORT>
POSTGRESQL_UI_USERNAME=<YOUR_POSTGRESQL_UI_EMAIL>
POSTGRESQL_UI_PASSWORD=<YOUR_POSTGRESQL_UI_PASSWORD>

#* Redis
REDIS_PASSWORD=<YOUR_REDIS_PASSWORD>
REDIS_DATABASE_HOST=<YOUR_REDIS_DATABASE_HOST> #! 绑定IP，例如 0.0.0.0 (所有接口) 或 127.0.0.1 (仅本地) 或 192.168.1.64 (指定IP)
REDIS_DATABASE_PORT=<YOUR_REDIS_DATABASE_PORT>
REDIS_UI_HOST=<YOUR_REDIS_UI_HOST> #! 绑定IP，例如 0.0.0.0 (所有接口) 或 127.0.0.1 (仅本地) 或 192.168.1.64 (指定IP)
REDIS_UI_PORT=<YOUR_REDIS_UI_PORT>

#* Kafka
KAFKA_INTERNAL_HOST_IP=<YOUR_KAFKA_INTERNAL_HOST_IP> #! Kafka 内部使用的 IP（用于 ADVERTISED_LISTENERS）
KAFKA_EXTERNAL_HOST=<YOUR_KAFKA_EXTERNAL_HOST> #! 绑定IP，例如 0.0.0.0 (所有接口) 或 127.0.0.1 (仅本地) 或 192.168.1.64 (指定IP)
KAFKA_EXTERNAL_PORT=<YOUR_KAFKA_EXTERNAL_PORT>
KAFKA_UI_HOST=<YOUR_KAFKA_UI_HOST> #! 绑定IP，例如 0.0.0.0 (所有接口) 或 127.0.0.1 (仅本地) 或 192.168.1.64 (指定IP)
KAFKA_UI_PORT=<YOUR_KAFKA_UI_PORT>

#* Minio
MINIO_ROOT_USER=<YOUR_MINIO_ROOT_USER>
MINIO_ROOT_PASSWORD=<YOUR_MINIO_ROOT_PASSWORD>
MINIO_API_HOST=<YOUR_MINIO_API_HOST> #! 绑定IP，例如 0.0.0.0 (所有接口) 或 127.0.0.1 (仅本地) 或 192.168.1.64 (指定IP)
MINIO_API_PORT=<YOUR_MINIO_API_PORT>
MINIO_UI_HOST=<YOUR_MINIO_UI_HOST> #! 绑定IP，例如 0.0.0.0 (所有接口) 或 127.0.0.1 (仅本地) 或 192.168.1.64 (指定IP)
MINIO_UI_PORT=<YOUR_MINIO_UI_PORT>
MINIO_SERVER_URL=http://<YOUR_MINIO_API_HOST>:<YOUR_MINIO_API_PORT> #! Console 用来访问 S3 API 的对外 URL
MINIO_BROWSER_REDIRECT_URL=http://<YOUR_MINIO_UI_HOST>:<YOUR_MINIO_UI_PORT> #! 浏览器打开 API 端口时跳转到 Console 的对外 URL

#* RabbitMQ
RABBITMQ_HOST=<YOUR_RABBITMQ_HOST> #! 绑定IP，例如 0.0.0.0 (所有接口) 或 127.0.0.1 (仅本地) 或 192.168.1.64 (指定IP)
RABBITMQ_AMQP_PORT=<YOUR_RABBITMQ_AMQP_PORT> #! AMQP 协议端口，默认 5672
RABBITMQ_UI_PORT=<YOUR_RABBITMQ_UI_PORT> #! Management UI 端口，默认 15672
RABBITMQ_HOST_NAME=<YOUR_RABBITMQ_HOST_NAME> #! 主机名，必须保持为 rabbitmq
RABBITMQ_NODE_NAME=<YOUR_RABBITMQ_NODE_NAME> #! 节点名称，后缀必须为 rabbitmq，例如 nfx_stack@rabbitmq
RABBITMQ_CLUSTER_NAME=<YOUR_RABBITMQ_CLUSTER_NAME> #! 集群名称，例如 nfx_stack_rabbit
RABBITMQ_DEFAULT_USER=<YOUR_RABBITMQ_DEFAULT_USER> #! 默认管理员用户名
RABBITMQ_DEFAULT_PASS=<YOUR_RABBITMQ_DEFAULT_PASS> #! 默认管理员密码
RABBITMQ_ERLANG_COOKIE=<YOUR_RABBITMQ_ERLANG_COOKIE> #! Erlang Cookie（用于集群通信的安全密钥）

#* Centrifugo
CENTRIFUGO_HOST=<YOUR_CENTRIFUGO_HOST>
CENTRIFUGO_PORT=<YOUR_CENTRIFUGO_PORT>
CENTRIFUGO_API_URL_INTERNAL=http://centrifugo:8000/api
CENTRIFUGO_API_KEY=<YOUR_CENTRIFUGO_API_KEY>
CENTRIFUGO_CLIENT_SECRET=<YOUR_CENTRIFUGO_CLIENT_SECRET>
CENTRIFUGO_PUBLIC_WS_URL=ws://<YOUR_CENTRIFUGO_HOST>:<YOUR_CENTRIFUGO_PORT>/connection/websocket
CENTRIFUGO_PUBLIC_SSE_URL=http://<YOUR_CENTRIFUGO_HOST>:<YOUR_CENTRIFUGO_PORT>/connection/sse

#* OpenTelemetry
OTEL_JAEGER_UI_HOST=<YOUR_OTEL_JAEGER_UI_HOST>
OTEL_JAEGER_UI_PORT=<YOUR_OTEL_JAEGER_UI_PORT>
OTEL_COLLECTOR_OTLP_GRPC_HOST=<YOUR_OTEL_COLLECTOR_OTLP_GRPC_HOST>
OTEL_COLLECTOR_OTLP_GRPC_PORT=<YOUR_OTEL_COLLECTOR_OTLP_GRPC_PORT>
OTEL_COLLECTOR_OTLP_HTTP_HOST=<YOUR_OTEL_COLLECTOR_OTLP_HTTP_HOST>
OTEL_COLLECTOR_OTLP_HTTP_PORT=<YOUR_OTEL_COLLECTOR_OTLP_HTTP_PORT>
OTEL_COLLECTOR_HEALTH_HOST=<YOUR_OTEL_COLLECTOR_HEALTH_HOST>
OTEL_COLLECTOR_HEALTH_PORT=<YOUR_OTEL_COLLECTOR_HEALTH_PORT>
OTEL_COLLECTOR_PROMETHEUS_HOST=<YOUR_OTEL_COLLECTOR_PROMETHEUS_HOST>
OTEL_COLLECTOR_PROMETHEUS_PORT=<YOUR_OTEL_COLLECTOR_PROMETHEUS_PORT>
OTEL_PROMETHEUS_HOST=<YOUR_OTEL_PROMETHEUS_HOST>
OTEL_PROMETHEUS_PORT=<YOUR_OTEL_PROMETHEUS_PORT>
OTEL_LOKI_HOST=<YOUR_OTEL_LOKI_HOST>
OTEL_LOKI_PORT=<YOUR_OTEL_LOKI_PORT>
OTEL_GRAFANA_HOST=<YOUR_OTEL_GRAFANA_HOST>
OTEL_GRAFANA_PORT=<YOUR_OTEL_GRAFANA_PORT>
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
OTEL_EXPORTER_OTLP_INSECURE=true
GRAFANA_ADMIN_USER=<YOUR_GRAFANA_ADMIN_USER>
GRAFANA_ADMIN_PASSWORD=<YOUR_GRAFANA_ADMIN_PASSWORD>

#* OpenSearch
OPENSEARCH_HOST=<YOUR_OPENSEARCH_HOST>
OPENSEARCH_EXTERNAL_PORT=<YOUR_OPENSEARCH_EXTERNAL_PORT>
OPENSEARCH_DASHBOARDS_HOST=<YOUR_OPENSEARCH_DASHBOARDS_HOST>
OPENSEARCH_DASHBOARDS_PORT=<YOUR_OPENSEARCH_DASHBOARDS_PORT>
OPENSEARCH_PASSWORD=<YOUR_OPENSEARCH_PASSWORD> #! 须通过 zxcvbn：≥8 位，大小写+数字+特殊字符，且不能太好猜（Lucas127. 会被判 Weak）
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

#! Public - 数据存储路径配置
# 注意：以下路径适用于 Linux 系统（如 NAS、服务器等）
# 如果使用 Windows 系统，请将路径改为 Windows 格式，例如：D:/Code/NFX-Stack/Databases/mysql

# MySQL
MYSQL_DATA_PATH=/home/kali/repo/Databases/mysql
MYSQL_INIT_PATH=/home/kali/repo/Databases/mysql-init
MYSQL_LOG_PATH=/home/kali/repo/Logs/mysql

# MongoDB
MONGO_DATA_PATH=/home/kali/repo/Databases/mongodb
MONGO_INIT_PATH=/home/kali/repo/Databases/mongodb-init
MONGO_LOG_PATH=/home/kali/repo/Logs/mongodb

# Redis
REDIS_DATA_PATH=/home/kali/repo/Databases/redis
REDIS_LOG_PATH=/home/kali/repo/Logs/redis

# Kafka
KAFKA_DATA_PATH=/home/kali/repo/Databases/kafka
KAFKA_LOG_PATH=/home/kali/repo/Logs/kafka

# MinIO
MINIO_DATA_PATH=/home/kali/repo/Databases/minio
MINIO_LOG_PATH=/home/kali/repo/Logs/minio

# PostgreSQL
POSTGRESQL_DATA_PATH=/home/kali/repo/Databases/postgresql
POSTGRESQL_INIT_PATH=/home/kali/repo/Databases/postgresql-init
POSTGRESQL_LOG_PATH=/home/kali/repo/Logs/postgresql

# RabbitMQ
RABBITMQ_DATA_PATH=/home/kali/repo/Databases/rabbitmq
RABBITMQ_LOG_PATH=/home/kali/repo/Logs/rabbitmq

# OpenTelemetry / OpenSearch
PROMETHEUS_DATA_PATH=/home/kali/repo/Databases/prometheus
LOKI_DATA_PATH=/home/kali/repo/Databases/loki
GRAFANA_DATA_PATH=/home/kali/repo/Databases/grafana
OPENSEARCH_DATA_PATH=/home/kali/repo/Databases/opensearch

#! 使用说明
# 1. 复制此文件为 .env：cp .example.env .env
# 2. 编辑 .env 文件，将所有的 <YOUR_XXX> 替换为实际值
# 3. 根据实际系统（Linux/Windows）调整数据存储路径
# 4. 确保所有目录路径存在且有正确的读写权限
# 5. 使用 ./start.sh 启动全部 Infrastructure 服务